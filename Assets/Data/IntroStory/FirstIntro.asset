  m_Script: {fileID: 11500000, guid: 99d1d129c52c255409c3c96df13182bc, type: 3}
  m_Name: FirstIntro
  m_EditorClassIdentifier: 
  dialogueList:
  - speaker: Masked one
    dialogue: My child...
  - speaker: You
    dialogue: Where am I?
  - speaker: You
    dialogue: Why is my head so...empty...?
  - speaker: You
    dialogue: Who...am I...?
  - speaker: Masked one
    dialogue: You must atone for your sins, my child.
  - speaker: You
    dialogue: Who are you? What sins?
  - speaker: Masked one
    dialogue: I am one of the Damned. And so will you...
  - speaker: Masked one
    dialogue: Now go.
